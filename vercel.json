{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "framework": "vite",
  "env": {
    "NPM_CONFIG_REGISTRY": "https://registry.npmmirror.com",
    "NODE_ENV": "production"
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
